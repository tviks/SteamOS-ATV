# Google TV's virtual keyboard belongs to Android, not Steam/gamescope.
# Android has its own event node; do not grant the host user a duplicate path.
SUBSYSTEM=="input", ATTRS{name}=="virtual-remote", ATTRS{id/vendor}=="18d1", ATTRS{id/product}=="0100", ENV{ID_INPUT}="", ENV{ID_INPUT_KEY}="", ENV{ID_INPUT_KEYBOARD}="", ENV{ID_INPUT_JOYSTICK}="", ENV{STEAMOS_POWER_BUTTON}="", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", TAG-="seat", TAG-="power-switch", OWNER:="root", GROUP:="root", MODE:="0600"
